# Template for intermediate student projects, not the root teaching repository.
# Use a supported Go version selected for the cohort, e.g. --build-arg GO_VERSION=...
ARG GO_VERSION
FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Adapt ./cmd/api if your module has a different entrypoint.
RUN CGO_ENABLED=0 go build -trimpath -o /out/api ./cmd/api

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 app
WORKDIR /app
COPY --from=build /out/api /app/api
USER 10001
EXPOSE 8080
ENTRYPOINT ["/app/api"]
